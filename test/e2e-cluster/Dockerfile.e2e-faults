FROM golang:1.25.0 AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -tags=e2e_faults -a -installsuffix cgo -ldflags="-s -w" -o /app/broker ./cmd/broker
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags="-s -w" -o /app/cli ./cmd/cli

FROM alpine:3.20

LABEL io.cursus.test-faults="true"
RUN apk add --no-cache bash curl \
    && addgroup -g 1000 cursus \
    && adduser -D -u 1000 -G cursus cursus \
    && mkdir -p /run/cursus-e2e-faults \
    && chown cursus:cursus /run/cursus-e2e-faults

WORKDIR /app
COPY --from=builder --chown=cursus:cursus /app/broker /app/broker
COPY --from=builder --chown=cursus:cursus /app/cli /app/cli
COPY --chown=cursus:cursus entrypoint.sh /app/entrypoint.sh

RUN chown -R cursus:cursus /app && chmod +x /app/broker /app/cli /app/entrypoint.sh
USER cursus

ENTRYPOINT ["/app/entrypoint.sh"]
CMD []