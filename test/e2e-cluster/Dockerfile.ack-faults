# Production broker code; NET_ADMIN is granted only by the isolated test fixture.
FROM golang:1.26.6 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /app/broker ./cmd/broker

FROM alpine:3.20
RUN apk add --no-cache bash curl iptables \
    && addgroup -g 1000 cursus \
    && adduser -D -u 1000 -G cursus cursus
WORKDIR /app
COPY --from=builder --chown=cursus:cursus /app/broker /app/broker
COPY --chown=cursus:cursus entrypoint.sh /app/entrypoint.sh
RUN mkdir -p /app/cluster-logs && chown -R cursus:cursus /app && chmod +x /app/entrypoint.sh
USER cursus
ENTRYPOINT ["/app/entrypoint.sh"]
